{
  "name": "haven-calhacks",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "speech": "node --import tsx scripts/speech.ts",
    "worker": "node --import tsx scripts/worker.ts",
    "verify:speech": "node --import tsx scripts/verify-speech.ts",
    "verify:personalization": "node --import tsx scripts/verify-personalization.ts",
    "verify:voice": "node --import tsx scripts/verify-voice.ts",
    "verify:services": "node --import tsx scripts/verify-services.ts",
    "test:http": "node tests/http-flow.mjs",
    "cleanup:demo": "node scripts/cleanup-demo.mjs",
    "test:rls": "node --import tsx scripts/test-live-rls.ts",
    "test:memory": "python3 -m unittest discover -s tests -p test_*.py -v",
    "prepare:voice": "node --import tsx scripts/prepare-voice-responses.ts",
    "benchmark:voice-router": "node --import tsx scripts/benchmark-quick-responses.ts",
    "measure:voice": "node --import tsx scripts/measure-voice-latency.ts",
    "verify:quick-voice": "node --import tsx scripts/verify-quick-voice.ts",
    "verify:journal": "node --import tsx scripts/verify-journal.ts",
    "verify:voice-natural": "node --import tsx scripts/verify-natural-voice.ts",
    "verify:friends": "node --import tsx scripts/verify-friends.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@daily-co/daily-js": "^0.94.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
