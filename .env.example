# Public Supabase project values (not administrative keys)
# This app also accepts an sb_publishable_ key in the ANON_KEY variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets. Never paste these into chat.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
ANTHROPIC_PLAN_MODEL=claude-sonnet-5-5
ANTHROPIC_MEMORY_MODEL=claude-haiku-5-5
MEMORY_SERVICE_URL=http://127.0.0.1:8001
MEMORY_SERVICE_TOKEN=
# Explicit fictional demo. Set false for production.
DEMO_ENABLED=true
APP_ORIGIN=http://localhost:3000
# Internal worker (not used for ordinary user requests)
# Accepts the new sb_secret_ key or a legacy service_role key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional photorealistic speaking avatar (server-only; D-ID Basic API credential)
DID_API_KEY=
# Public HTTPS portrait URL; defaults to D-ID's Noelle presenter
DID_SOURCE_URL=
DID_VOICE_ID=en-US-JennyNeural

# Optional enhanced human-like speech. Server-only; choose and audition voices in Cartesia.
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_BLACK_CAT=5ee9feff-1265-424a-9d7f-8e4d431a12c7
CARTESIA_VOICE_WHITE_CAT=ca566b43-944e-4474-b494-7d9f0695f307

# Static conversational replies are retired; this legacy flag has no effect.
# Progressive PCM playback remains available.
VOICE_QUICK_RESPONSES=false
VOICE_STREAM_AUDIO=false
# VOICE_RESPONSE_CACHE_DIR=.voice-cache

# English streaming STT; other languages keep local recognition.
VOICE_REALTIME_STT=false
# CARTESIA_STT_MODEL=ink-2

# Prepare contextual replies from interim speech; only final turns can speak/save.
VOICE_SPECULATIVE_GENERATION=false


# Server-only Daily private meal video credentials.
DAILY_API_KEY=

# Extra key for signed-in owners opening the Memory preview (default: true).
MEMORY_PREVIEW_KEY_REQUIRED=true
